# GEMINI_API_KEY: Required for server-side Gemini AI reasoning and explanation layer.
# In Google AI Studio, this is injected automatically from user settings.
GEMINI_API_KEY=

# VITE_API_BASE_URL: Optional custom backend API URL (e.g. for GitHub Pages static deployments).
# Defaults to same-origin relative URLs (/api/*) in Google AI Studio and Localhost development.
VITE_API_BASE_URL=

# APP_URL: URL where the application is hosted.
APP_URL=
